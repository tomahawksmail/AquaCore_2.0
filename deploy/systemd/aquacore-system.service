[Unit]
Description=AquaCore Orange Pi system metrics collector
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=simple
User=aquacore
Group=aquacore
WorkingDirectory=/opt/aquacore
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/aquacore/web.env
ExecStart=/opt/aquacore/.venv/bin/python /opt/aquacore/system_collector.py --interval 10
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
