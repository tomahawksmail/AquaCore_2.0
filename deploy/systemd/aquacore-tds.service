[Unit]
Description=AquaCore adjusted TDS sensor collector (ADS1115 A3)
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=simple
User=aquacore
Group=aquacore
SupplementaryGroups=i2c
WorkingDirectory=/opt/aquacore
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/aquacore/web.env
ExecStart=/opt/aquacore/.venv/bin/python /opt/aquacore/tds_collector.py --bus 2 --temperature 22 --interval 30
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
